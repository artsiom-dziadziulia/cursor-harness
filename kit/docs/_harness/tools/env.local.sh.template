# Project-local harness runtime (generated by aw-harness-init / install.sh).
# Sourced by docs/_harness/tools/env.sh — edit freely.

# docker | host
AW_RUNTIME="{{AW_RUNTIME}}"

# Relative to Magento root (host)
AW_MODULES_REL="{{MAGENTO_CODE_PATH}}"

# Docker (ignored when AW_RUNTIME=host)
AW_COMPOSE_DIR="{{COMPOSE_DIR}}"
AW_COMPOSE_PROJECT="{{COMPOSE_PROJECT}}"
AW_CONTAINER="{{PHP_CONTAINER}}"
# Magento root *inside* the PHP runtime (container workdir or host path for host mode)
AW_MAGENTO_ROOT_IN_RUNTIME="{{RUNTIME_MAGENTO_ROOT}}"

# How to start the stack (human hint only)
AW_STACK_HINT="{{STACK_HINT}}"
